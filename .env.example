# Copy to .env (never commit .env). Synthetic data only.
# No Anthropic key? The organisers' free options work too (no payment card): Groq (console.groq.com) or Google AI Studio
# (aistudio.google.com). Example: LLM_PROVIDER=groq, GROQ_API_KEY=..., GROQ_MODEL=<exact id from the console>.
# Then `pnpm smoke` runs 15 sentences through the whole pipeline with that model and prints PASS/FAIL per sentence.
LLM_PROVIDER=anthropic        # anthropic|groq|gemini|openrouter|local|fake (fake = scripted demo sentences, no key)
LLM_MODE=tools                # tools|workflow
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_FALLBACKS=groq,gemini,local
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_DAILY_TOKEN_CAP=2000000   # per provider per UTC day; prices are not assumed
LLM_REQUEST_INTERVAL_MS=0    # optional minimum spacing between request starts, incl retries (0..60000); 0 = none
LLM_REQUESTS_PER_MIN=14      # request starts per rolling minute, per provider per process (incl retries); 0 = no cap
LLM_MAX_WAIT_MS=20000        # longest wait for a slot or a 429 retry hint; past it the turn answers "busy" at once
LLM_TURN_DEADLINE_MS=30000   # web app: all model requests of one turn finish or answer "busy" within this
GROQ_MODEL=                  # exact model id from the Groq console
GEMINI_MODEL=                # exact model id (Gemini 3 family) from AI Studio
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
LOCAL_BASE_URL=              # e.g. http://localhost:11434/v1 (Ollama)
LOCAL_MODEL=
LLM_CACHE=1
DEMO_MODE=1
# Hosted demo limits (web app). Turns = typed or spoken messages that may reach the model.
TURNS_PER_10_MIN=60          # per browser session
TURNS_PER_10_MIN_IP=100      # per client IP (first X-Forwarded-For hop): rotating session ids does not reset it
TURNS_PER_10_MIN_GLOBAL=150  # whole process
SANDBOX_MAX=200              # in-memory wallets, one per browser session
SANDBOX_IDLE_MIN=30          # untouched this long: dropped
SANDBOX_PROTECT_MIN=10       # acted on within this, or a card pending: never evicted; a full house answers "busy" instead
SANDBOX_NEW_PER_IP_10_MIN=40 # new sandboxes per client IP (a judging room shares one Wi-Fi IP)
ADMIN_SECRET=
# Voice (docs/09). Off unless a provider is configured; the text path never depends on it.
# ASR_PROVIDER: regalabs | openai-compat | fake | off (unset: regalabs if REGALABS_API_KEY is set, else off)
ASR_PROVIDER=
REGALABS_API_KEY=            # rega_live_... developer key (server-side only, never sent to the browser)
REGALABS_BASE_URL=https://api.regalabs.dev/v1
REGALABS_STREAM_URL=        # hosted demo: wss://api.regalabs.dev/v1/audio/transcriptions/stream; unset for laptop REST
REGALABS_ASR_LANGUAGE=auto   # RegaLabs detects the language (Iraqi Arabic and Kurdish); set e.g. "ckb" or "ar" to force one
ASR_MODEL_REVISION=          # exact checkpoint/version; changes invalidate voice-eval cache (especially local Stage-11)
# Optional Whisper-style baseline for the WER comparison (any OpenAI-compatible /audio/transcriptions):
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
ASR_LANGUAGE=ar
ASR_TIMEOUT_MS=15000
ASR_MAX_SECONDS=30
ASR_CONF_LOW=0.5             # below: ask to repeat
ASR_CONF_HIGH=0.8            # below: read the transcript back for a tap
ASR_NO_CONFIDENCE=readback   # RegaLabs returns no confidence: readback (default) or accept
VOICE_CAPTURE_DIR=           # e.g. eval/voice/captures to collect consented recordings for the voice eval
