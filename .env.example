# Copy to .env (never commit .env). Synthetic data only.
LLM_PROVIDER=anthropic        # anthropic|groq|gemini|openrouter|local|fake (fake = scripted demo sentences, no key)
LLM_MODE=tools                # tools|workflow
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_HARD_MODEL=claude-sonnet-5-5
LLM_FALLBACKS=groq,gemini,local
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_DAILY_TOKEN_CAP=2000000   # per provider per UTC day; prices are not assumed
GROQ_MODEL=                  # exact model id from the Groq console
GEMINI_MODEL=                # exact model id (Gemini 3 family) from AI Studio
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
LOCAL_BASE_URL=              # e.g. http://localhost:11434/v1 (Ollama)
LOCAL_MODEL=
LLM_CACHE=1
WALLET_API_URL=http://localhost:8787
DEMO_MODE=1
ADMIN_SECRET=
# Voice (docs/09). Off unless a provider is configured; the text path never depends on it.
# ASR_PROVIDER: regalabs | openai-compat | fake | off (unset: regalabs if REGALABS_API_KEY is set, else off)
ASR_PROVIDER=
REGALABS_API_KEY=            # rega_live_... developer key (server-side only, never sent to the browser)
REGALABS_BASE_URL=https://api.regalabs.dev/v1
REGALABS_ASR_LANGUAGE=acm    # Iraqi Arabic; the gateway must allow "acm" (see docs/09), else "ar" (MSA model)
# Optional Whisper-style baseline for the WER comparison (any OpenAI-compatible /audio/transcriptions):
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
ASR_LANGUAGE=ar
ASR_TIMEOUT_MS=15000
ASR_MAX_SECONDS=30
ASR_CONF_LOW=0.5             # below: ask to repeat
ASR_CONF_HIGH=0.8            # below: read the transcript back for a tap
ASR_NO_CONFIDENCE=readback   # RegaLabs returns no confidence: readback (default) or accept
VOICE_CAPTURE_DIR=           # e.g. eval/voice/captures to collect consented recordings for the voice eval
CONFIRM_TOKEN_TTL_S=120
