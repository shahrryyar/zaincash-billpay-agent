{
  "name": "zaincash-billpay-agent",
  "private": true,
  "version": "0.0.0",
  "description": "ZainCash Agentic AI Challenge, Topic 04: Iraqi Arabic Bill Pay & Transfer Agent",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "stress": "pnpm --filter @zc/wallet-api stress",
    "dev": "pnpm --filter @zc/web dev",
    "build": "pnpm --filter @zc/web build",
    "eval": "pnpm --filter @zc/eval eval",
    "cli": "pnpm --filter @zc/orchestrator cli",
    "smoke": "pnpm --filter @zc/orchestrator smoke"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "license": "UNLICENSED"
}
